<resources>

    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcButtonNumber" parent="CalcButtonBase">
        <item name="android:backgroundTint">@color/btn_number</item>
        <item name="android:textColor">@color/btn_text_light</item>
    </style>

    <style name="CalcButtonFunction" parent="CalcButtonBase">
        <item name="android:backgroundTint">@color/btn_function</item>
        <item name="android:textColor">@color/btn_text_dark</item>
    </style>

    <style name="CalcButtonOperator" parent="CalcButtonBase">
        <item name="android:backgroundTint">@color/btn_operator</item>
        <item name="android:textColor">@color/btn_text_light</item>
    </style>

</resources>
